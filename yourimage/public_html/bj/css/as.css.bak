/****BEGIN FOOTER****/
 #footer-linklist {
    width: 1004px;
    margin: 26px auto 50px;
}
#square-foot-contain {
    width: 426px;
    float: left;
}
#shows-foot-col {
    width: 186px;
}
.footsquare-holder {
    float: left;
    margin-right: 30px;
}
ul.foot-nav {
    float: right;
    width: 94px;
}
ul.foot-nav li {
    margin-bottom: 13px;
}
.foot-nav a, .foot-nav a:link, .foot-nav a:visited {
    font-family: arial;
    font-weight: bold;
    color: #242424;
    text-decoration: none;
    font-size: 11px;
}
.link-col {
    float: left;
}
.link-col h4 {
    font-family: Helvetica, arial;
    color: #242424;
    font-size: 0.8em;
    font-weight: bold;
    margin: 3px 0px 19px 19px;
}
ul.social {
    border-left: 1px solid #babab5;
}
ul.footer-list {
    padding: 0px;
    margin: 0px;
    height: 210px;
    border-left: 1px solid #babab5;
}
.darkbg ul.footer-list {
    border-left: 1px solid #666666;
}
ul.footer-list li {
    line-height: 0.8em;
    margin: 0px 0px 6px 20px;
    position: relative;
    width: 169px;
    height: 20px;
}
ul.social li {
    margin-bottom: 12px !important;
    width: 140px !important;
}
ul.gamelinks li {
    width: 186px !important;
}
ul.social li:hover .social-img img {
    left: -50px;
}
ul.footer-list li a, ul.footer-list li a:link, ul.footer-list li a:visited {
    font-family: Helvetica, arial;
    font-size: 10px;
    color: #242424;
    font-weight: bold;
    display: block;
    position: absolute;
    width: 163px;
    height: 20px;
    left: 0px;
    top: -5px;
}
.darkbg .foot-nav a, .darkbg .foot-nav a:link, .darkbg .foot-nav a:visited, .darkbg .link-col h4, .darkbg ul.footer-list li a, .darkbg ul.footer-list li a:link, .darkbg ul.footer-list li a:visited {
    color: #ffffff;
}
ul.footer-list li a:hover, ul.footer-list li a:active, ul.social li:hover a, .darkbg ul.footer-list li a:hover, .darkbg ul.footer-list li a:active, .darkbg ul.social li:hover a {
    color: #ff4c26;
}
.foot-nav a:hover, .foot-nav a:active, .darkbg .foot-nav a:hover, .darkbg .foot-nav a:active {
    color: #ff4c26;
}
.social a {
    position: relative !important;
    top: -1px !important;
}
a.soc-count {
    width: 68px !important;
    display: inline-block !important;
    *display: inline;
    zoom: 1;
}
.global-footer {
    background: url('https://s.cdn.turner.com/adultswim/big/img/home/bg-footer-tile.png') 0 0 repeat;
    padding-top: 40px;
}
.social-img {
    overflow: hidden;
    cursor: pointer;
    position: relative;
    display: inline-block;
    *display: inline;
    zoom: 1;
    margin: 0px 8px -3px 0px;
}
.social-img img {
    display: block;
    position: absolute;
    left: -26px;
}
.darkbg .social-img img {
    left: -2px;
}
.social-img:hover img {
    left: -50px;
}
#fb-link {
    height: 16px;
    width: 16px;
}
#fb-link img {
    top: 0px;
}
