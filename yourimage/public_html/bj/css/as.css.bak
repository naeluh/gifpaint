}
#legal-footer {
    text-align: center;
    font: 7px/6px Helvetica, Arial, sans-serif;
}
#legal-links {
    /* margin-bottom: 3px; */
    ;
}
#legal-links li {
    display: inline;
}
#legal-links li a {
    color: #696969 !important;
    text-decoration: none !important;
}
#legal-links .legal-divider {
    color: #aaaaaa;
    margin: 0 0 0 5px;
}
#small-logo {
    padding-left: 5px;
    vertical-align: middle;
    display: inline;
    font-size: 0;
}
#tbs-info {
    margin: 0px;
    color: #696969;
    line-height: 175%;
    filter: alpha(opacity=85);
    -moz-opacity: .85;
    opacity: .85;
}
#tbs-info a {
    color: #696969 !important;
    text-decoration: none !important;
}
#adultswim-info {
    margin: 0px;
    color: #696969;
    line-height: 14px;
    padding-bottom: 0px !important;
    filter: alpha(opacity=85);
    -moz-opacity: .85;
    opacity: .85;
}
#adultswim-info img {
    vertical-align: middle;
    display: inline;
}
/* CUSTOM CSS FOR DARK/LIGHT LEGAL */
 .light-page #legal-links li a {
    color: #b5b6a8 !important;
}
.ad-choice-area a {
    font-weight: bold;
}