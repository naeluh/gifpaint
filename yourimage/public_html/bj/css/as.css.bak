html, body {
    width: 100%;
    height: 100%;
    margin: 0px;
    border: 0;
    overflow: hidden;
    /*  Disable scrollbars */
    display: block;
    /* No floating content on sides */
}
#full-nav, #phone-nav, #push-nav-left {
    z-index:9999;
}
#videoWrapper img {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}
#videoWrapper iframe {
    position: relative;
    top: 0;
    left: 19px;
    width: 92.79%;
    height: 100%;
    -webkit-transition: all 1ms linear;
    -moz-transition: all 1ms linear;
    -o-transition: all 1ms linear;
    transition: all 1ms linear;
}
#videoWrapper {
    position: absolute;
    top: 0;
    bottom: 172px;
    left: 0;
    right: 0;
    margin: auto;
    width: 50%;
    height: 50%;
    z-index: 8;
    -webkit-transition: all 1ms linear;
    -moz-transition: all 1ms linear;
    -o-transition: all 1ms linear;
    transition: all 1ms linear;
}
#myCanvas {
    z-index: 1;
    display: block;
    position: absolute;
    bottom: 33px;
    left: 0;
    right: 0;
}
#myCanvas2 {
    z-index: -1;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
}
#center {
    width: 50%;
    height: 100%;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: auto;
}
#hands {
    width: 50%;
    height: 100%;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: auto;
}
#left {
    z-index: 8;
    height: 50%;
    width: 50%;
    margin: auto;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 66px;
    right: auto;
}
#right {
    z-index: 8;
    height: 50%;
    width: 50%;
    margin: auto;
    position: absolute;
    top: 0;
    left: auto;
    bottom: 66px;
    right: 0;
}
#hands img {
    width: 100%;
}
#rating-icon {
    margin: 3px;
    position: absolute;
    left: 0;
    width: 21px;
    z-index: 3;
}
#txtImages {
    position: relative;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: auto;
    height: 50%;
    z-index: 8;
    padding-top: 4%;
}
#blogo {
    width: 50%;
    margin: 0 auto;
    margin-bottom: 2%;
}
#tune {
    width: 74%;
    margin: 0 auto;
}
#tune_two {
    width: 39%;
    margin: 0 auto;
}
#aslogo {
    bottom: 0;
    width: 22%;
    margin: auto;
    padding: 2% 0;
}
footer {
    position: absolute;
    bottom: 0;
    left: 0;
    margin: auto;
    width: 100%;
    opacity: 0.5;
}
#loading {
    z-index: -2;
    height: 50%;
    width: 50%;
    max-width: 16px;
    min-width: 16px;
    min-height: 16px;
    max-height: 16px;
    margin: auto;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
}
 @media only screen and (min-device-width : 540px) and (max-device-width : 960px) and (webkit-min-device-pixel-ratio: 2) {
    #videoWrapper {
        position: absolute;
        top: 0;
        bottom: 126px !important;
        left: 0;
        right: 0;
        margin: auto;
        width: 50%;
        height: 50%;
        z-index: 8;
    }
    #videoWrapper iframe {
        position: relative;
        top: 0;
        left: 8px !important;
        width: 96% !important;
        height: 100%;
        webkit-transition: all 1ms linear;
        -moz-transition: all 1ms linear;
        -o-transition: all 1ms linear;
        transition: all 1ms linear;
    }
}
