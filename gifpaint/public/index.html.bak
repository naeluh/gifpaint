function mouseInit(){window.addEventListener("mousedown",function(a){createCanvas(ct,canarr);createCanvas(ct2)});window.addEventListener("mousemove",function(a){pos.unshift({x:a.clientX,y:a.clientY,t:performance.now()});pos.length=Math.min(pos.length,30);var b=calculateVelocities(pos),d=calculateAccelerations(b);average(b);r=0<=average(d)?value++:value--;100<r&&(r=value-=100);5>r&&(r=value+=100);b=ct2[Number(ct2.length)-1];Number(ct2.length)-1>=Number(g.length)&&(b=ct2[Number(g.length)-1]);void 0!==
