function recursiveLoad(a){setTimeout(function(){var b="#"+Math.random().toString(16).slice(2,8);!0===a.rendered?done(a,b):recursiveLoad(a)},1E3)}function done(a,b){trueArr.push(a.src);$("#loading").append('<p style="color:'+b+';">'+trueArr.length+"</>");g.length===trueArr.length&&($("#loading").fadeOut(100),$("#contain").fadeOut(100),animloop(),mouseInit())}
function calculateVelocities(a){return a.reduce(function(b,a,c,e){if(0<c){c-=1;var f=a.x-e[c].x,h=a.y-e[c].y;b.push(Math.sqrt(f*f+h*h)/(e[c].t-a.t))}return b},[])}function calculateAccelerations(a){return a.reduce(function(a,d,c,e){0<c&&a.push(e[c-1]-d);return a},[])}function average(a){return 0<a.length?a.reduce(function(a,d){return a+d},0)/a.length:0}
